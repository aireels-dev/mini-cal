    "Partial support: Japanese, Korean, Vietnamese, Persian, Thai, Turkish" : {

    },
    "permission.calendar.description" : {
      "comment" : "Localized string for: 授权后可同步 iCloud 和本地日历的事件",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزامنة أحداث iCloud والتقويم المحلي بعد التفويض"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync iCloud and local calendar events after authorization"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی رویدادهای iCloud و تقویم محلی پس از مجوز"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרן אירועי iCloud ולוח שנה מקומי לאחר אישור"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認後、iCloudとローカルカレンダーのイベントを同期"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인 후 iCloud 및 로컬 달력 이벤트 동기화"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซิงค์เหตุการณ์ iCloud และปฏิทินท้องถิ่นหลังจากได้รับอนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yetkilendirme sonrası iCloud ve yerel takvim etkinliklerini senkronize et"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجازت کے بعد iCloud اور مقامی کیلنڈر کے واقعات کو مطابقت دیں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ sự kiện iCloud và lịch cục bộ sau khi ủy quyền"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权后可同步 iCloud 和本地日历的事件"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權後可同步 iCloud 和本地日曆的事件"
          }
        }
      }
    },
    "permission.calendar.hint" : {
      "comment" : "Localized string for: 提示:点击按钮将打开系统设置,在「隐私与安全性」>「日历」中授权",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلميح: انقر فوق الزر لفتح إعدادات النظام والتفويض في الخصوصية والأمان > التقويم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Click button to open System Settings and authorize in Privacy & Security > Calendar"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نکته: برای باز کردن تنظیمات سیستم و مجوز در حریم خصوصی و امنیت > تقویم روی دکمه کلیک کنید"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיפ: לחץ על הכפתור לפתיחת הגדרות מערכת ואשר בפרטיות ואבטחה > לוח שנה"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：ボタンをクリックしてシステム設定を開き、プライバシーとセキュリティ > カレンダーで承認"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 버튼을 클릭하여 시스템 설정을 열고 개인 정보 보호 및 보안 > 달력에서 승인"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคล็ดลับ: คลิกปุ่มเพื่อเปิดการตั้งค่าระบบและอนุญาตในความเป็นส่วนตัวและความปลอดภัย > ปฏิทิน"
          }
        },
        "tr" : {
