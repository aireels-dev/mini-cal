    "settings.theme_auto_switch" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 عندما يتغير مظهر النظام، سيتم التبديل تلقائياً إلى المظهر المحدد لهذا الوضع"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 When system appearance changes, it will automatically switch to your selected theme for that mode"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 هنگامی که ظاهر سیستم تغییر می‌کند، به‌طور خودکار به تم انتخابی شما برای آن حالت تغییر می‌کند"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 כאשר מראה המערכת משתנה, זה יעבור אוטומטית לערכת הנושא שבחרת עבור מצב זה"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 システム外観が変更されると、そのモードで選択したテーマに自動的に切り替わります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 시스템 외관이 변경되면 해당 모드에서 선택한 테마로 자동 전환됩니다"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 เมื่อรูปลักษณ์ระบบเปลี่ยนแปลง จะสลับไปยังธีมที่คุณเลือกสำหรับโหมดนั้นโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Sistem görünümü değiştiğinde, o mod için seçtiğiniz temaya otomatik olarak geçecektir"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 جب سسٹم کی ظاہری شکل تبدیل ہوتی ہے، تو یہ خودکار طور پر اس موڈ کے لیے آپ کے منتخب کردہ تھیم میں سوئچ ہو جائے گا"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 Khi giao diện hệ thống thay đổi, sẽ tự động chuyển sang chủ đề đã chọn cho chế độ đó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 系统外观变化时，将自动切换到对应模式下您选择的主题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💡 系統外觀變化時，將自動切換到對應模式下您選擇的主題"
          }
        }
      }
    },
    "settings.week_start.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد أول يوم في الأسبوع في شبكة التقويم، يؤثر على التخطيط وعناوين أيام الأسبوع"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the first day of week in calendar grid, affects layout and weekday headers"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روز اول هفته را در شبکه تقویم تنظیم می‌کند و بر چیدمان و عنوان‌های روزها اثر می‌گذارد"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובע את היום הראשון בשבוע בתצוגת לוח השנה ומשפיע על הפריסה וכותרות הימים"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーの週の開始日を設定します。レイアウトと曜日ヘッダーに影響します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달력 그리드에서 한 주의 시작일을 설정하며 레이아웃과 요일 헤더에 영향을 줍니다"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดวันเริ่มต้นของสัปดาห์ในตารางปฏิทิน ส่งผลต่อเลย์เอาต์และหัวข้อวันในสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim ızgarasında haftanın ilk gününü ayarlar; düzeni ve hafta günü başlıklarını etkiler"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیلنڈر گرڈ میں ہفتے کے پہلے دن کو سیٹ کریں، یہ لے آؤٹ اور ہفتہ وار ہیڈر پر اثر انداز ہوتا ہے"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt ngày bắt đầu tuần trong lưới lịch, ảnh hưởng đến bố cục và tiêu đề ngày trong tuần"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置日历网格中每周的起始日，影响日历布局和星期头部显示"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設置日曆網格中每週的起始日，影響日曆佈局和星期頭部顯示"
