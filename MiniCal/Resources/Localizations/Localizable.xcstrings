    "onboarding.complete.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ جاهز للاستخدام. انقر على أيقونة شريط القائمة للبدء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is ready to use. Click the menu bar icon to start."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ آماده استفاده است. برای شروع روی آیکون نوار منو کلیک کنید."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ מוכן לשימוש. לחץ על סמל שורת התפריטים כדי להתחיל."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の準備ができました。メニューバーのアイコンをクリックして開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@가 준비되었습니다. 메뉴 막대 아이콘을 클릭하여 시작하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ พร้อมใช้งานแล้ว คลิกไอคอนแถบเมนูเพื่อเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kullanıma hazır. Başlamak için menü çubuğu simgesine tıklayın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ استعمال کے لیے تیار ہے۔ شروع کرنے کے لیے مینو بار آئیکن پر کلک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã sẵn sàng sử dụng. Nhấp vào biểu tượng thanh menu để bắt đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已准备就绪。点击菜单栏图标开始使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已準備就緒。點擊菜單欄圖標開始使用。"
          }
        }
      }
    },
