    "local_group.confirm_delete_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من حذف الفئة \"%@\"؟ سيتم نقل جميع الأحداث في هذه المجموعة إلى الافتراضي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete the category \"%@\"? All events in this group will be moved to default."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئن هستید که می‌خواهید دسته \"%@\" را حذف کنید؟ همه رویدادهای این گروه به پیش‌فرض منتقل خواهند شد."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שברצונך למחוק את הקטגוריה \"%@\"? כל האירועים בקבוצה זו יועברו לברירת המחדל."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリ「%@」を削除してもよろしいですか？このグループのすべてのイベントはデフォルトに移動されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카테고리 \"%@\"을(를) 삭제하시겠습니까? 이 그룹의 모든 이벤트가 기본값으로 이동됩니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือไม่ที่จะลบหมวดหมู่ \"%@\" เหตุการณ์ทั้งหมดในกลุ่มนี้จะถูกย้ายไปยังค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" kategorisini silmek istediğinizden emin misiniz? Bu gruptaki tüm etkinlikler varsayılana taşınacak."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا آپ واقعی \"%@\" زمرہ کو حذف کرنا چاہتے ہیں؟ اس گروپ کے تمام واقعات ڈیفالٹ میں منتقل ہو جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc chắn muốn xóa danh mục \"%@\"? Tất cả sự kiện trong nhóm này sẽ được chuyển về mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要删除类别「%@」吗？该组的所有事件将移动到默认中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確定要刪除類別「%@」嗎？該組的所有事件將移動到預設中。"
          }
        }
      }
    },
