    "about.message" : {
      "comment" : "About dialog message with version and app name",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإصدار %@\n\nتطبيق تقويم جميل لشريط قوائم macOS\n\n© 2025 %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@\n\nA clean and elegant macOS menu bar calendar app\n\n© 2025 %@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه %@\n\nیک تقویم زیبا برای نوار منوی macOS\n\n© 2025 %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסה %@\n\nיישום לוח שנה אלגנטי לשורת התפריטים של macOS\n\n© 2025 %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン %@\n\nmacOS のメニューバー用のシンプルで洗練されたカレンダーアプリ\n\n© 2025 %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버전 %@\n\nmacOS 메뉴 막대용 깔끔하고 우아한 캘린더 앱\n\n© 2025 %@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวอร์ชัน %@\n\nแอปปฏิทินแถบเมนู macOS ที่เรียบง่ายและสวยงาม\n\n© 2025 %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürüm %@\n\nmacOS menü çubuğu için sade ve zarif bir takvim uygulaması\n\n© 2025 %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورژن %@\n\nmacOS مینو بار کے لیے ایک سادہ اور خوبصورت کیلنڈر ایپ\n\n© 2025 %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản %@\n\nỨng dụng lịch thanh menu macOS gọn gàng và tinh tế\n\n© 2025 %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本 %@\n\n一款简洁优雅的 macOS 菜单栏日历应用\n\n© 2025 %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本 %@\n\n一款簡潔優雅的 macOS 選單欄日曆應用\n\n© 2025 %@"
          }
        }
      }
