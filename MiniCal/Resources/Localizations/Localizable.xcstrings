    "theme_mode.dark.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم دائماً المظهر الداكن، مناسب للبيئات المعتمة أو الليل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always use dark theme, suitable for dim environments or nighttime"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همیشه از تم تیره استفاده کنید، مناسب برای محیط های کم نور یا شب"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש תמיד בערכת נושא כהה, מתאים לסביבות עמומות או שימוש לילי"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常にダークテーマを使用、暗い環境や夜間に適しています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 다크 테마 사용, 어두운 환경이나 야간에 적합"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ธีมมืดเสมอ เหมาะสำหรับสภาพแวดล้อมที่มืดหรือเวลากลางคืน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her zaman koyu tema kullan, karanlık ortamlar veya gece için uygundur"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہمیشہ گہرا تھیم استعمال کریں، مدھم ماحول یا رات کے لیے موزوں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn sử dụng chủ đề tối, phù hợp cho môi trường tối hoặc ban đêm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终使用深色主题，适合在昏暗环境或夜间使用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
